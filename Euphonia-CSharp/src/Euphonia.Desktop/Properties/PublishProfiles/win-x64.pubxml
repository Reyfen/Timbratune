<Project>
  <!-- One self-contained executable for win-x64: no .NET install needed on the target.
       dotnet publish src/Euphonia.Desktop -p:PublishProfile=win-x64
       Native libraries (Skia, HarfBuzz, miniaudio, ANGLE) are inside the file and are
       unpacked once to the .NET bundle cache on first start. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- just the executable: no symbol or XML doc files from the libraries -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\Euphonia-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
