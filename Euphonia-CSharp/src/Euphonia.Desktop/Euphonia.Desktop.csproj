<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop head (Windows today; macOS/Linux use the same code). Analysis is
       pure C# (Euphonia.Acoustics), so nothing external is bundled. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Euphonia.Desktop</RootNamespace>
    <ApplicationIcon>..\Euphonia\Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Euphonia\Euphonia.csproj" />
    <ProjectReference Include="..\Euphonia.Audio.SoundFlow\Euphonia.Audio.SoundFlow.csproj" />
  </ItemGroup>
  <!-- Single-file publishes are named by version and platform: Euphonia-Desktop-v0.1.0-win-x64.exe, Euphonia-Desktop-v0.1.0-linux-x64.
       (The assembly itself can't be renamed to that: the UI library is already called Euphonia.) -->
  <Target Name="NameSingleFileForPlatform" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <_EuphoniaExe>$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)</_EuphoniaExe>
      <_EuphoniaNamed>$(PublishDir)Euphonia-Desktop-v$(Version)-$(RuntimeIdentifier)$(_NativeExecutableExtension)</_EuphoniaNamed>
    </PropertyGroup>
    <Move SourceFiles="$(_EuphoniaExe)" DestinationFiles="$(_EuphoniaNamed)" Condition="Exists('$(_EuphoniaExe)')" />
  </Target>
</Project>
