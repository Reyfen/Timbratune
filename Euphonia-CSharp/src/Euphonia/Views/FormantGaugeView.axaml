<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Euphonia.ViewModels"
             xmlns:c="using:Euphonia.Controls"
             x:Class="Euphonia.Views.FormantGaugeView"
             x:DataType="vm:GaugeViewModel">
  <!-- FormantGauge.tsx -->
  <Button Classes="card inner" Command="{Binding Open}" IsEnabled="{Binding Interactive}" ToolTip.Tip="{Binding ToolTip}">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock VerticalAlignment="Center">
          <Run Text="{Binding Name}" FontWeight="Bold" FontSize="15" />
          <Run Text="{Binding Description}" Foreground="{DynamicResource InkSoftBrush}" FontSize="12.5" />
        </TextBlock>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding ValueText}" />
          <c:ZonePill Zone="{Binding Zone}" VerticalAlignment="Center" />
          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource InkAccentBrush}" Text="↗"
                     IsVisible="{Binding Interactive}" />
        </StackPanel>
      </Grid>
      <c:ZoneBar Zones="{Binding Zones}" Value="{Binding Value}" Lo="{Binding Lo}" Hi="{Binding Hi}" />
      <Grid ColumnDefinitions="*,*">
        <TextBlock Classes="cap" FontSize="11" Text="← deeper / larger tract" />
        <TextBlock Grid.Column="1" Classes="cap" FontSize="11" HorizontalAlignment="Right" Text="brighter / smaller tract →" />
      </Grid>
    </StackPanel>
  </Button>
</UserControl>
