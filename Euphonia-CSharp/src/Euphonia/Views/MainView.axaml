<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Euphonia.ViewModels"
             xmlns:c="using:Euphonia.Controls"
             xmlns:v="using:Euphonia.Views"
             x:Class="Euphonia.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource PageBackgroundBrush}">
  <!-- Port of dashboard-react/src/App.tsx: one scrolling page, top to bottom. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseModalCommand}" />
  </UserControl.KeyBindings>

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="1140" Margin="24,20,24,40" Spacing="28">

        <!-- ========== hero ========== -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="h1" Text="🎀 Euphonia" />
            <TextBlock Classes="cap" FontSize="14" Text="finding the sound that feels like you 💗✨" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Top" FontSize="18"
                  Content="🌓" ToolTip.Tip="switch light / dark" Command="{Binding ToggleThemeCommand}" />
        </Grid>

        <Border Classes="card" Padding="16,10" IsVisible="{Binding HasActive}" HorizontalAlignment="Left">
          <TextBlock>
            <Run Text="{Binding Active.Banner, FallbackValue=''}" FontWeight="SemiBold" />
            <Run Text="{Binding Active.Date, FallbackValue=''}" Foreground="{DynamicResource InkSoftBrush}" />
          </TextBlock>
        </Border>

        <!-- ========== record panel (RecordButton.tsx) ========== -->
        <Border Classes="card" DataContext="{Binding Record}" x:DataType="vm:RecordViewModel">
          <StackPanel Spacing="8">
            <WrapPanel IsVisible="{Binding IsIdle}">
              <TextBox Classes="label-input" Margin="0,0,10,6" Text="{Binding Label}"
                       Watermark="what are you trying this take? ✨" />
              <Button Classes="primary" Margin="0,0,10,6" Content="🎙️ record" Command="{Binding StartCommand}" />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                <TextBlock Classes="cap" VerticalAlignment="Center" Text="live graphs show:" />
                <ComboBox ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding LiveWindow}" MinWidth="130" />
              </StackPanel>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsRecording}">
              <Button Classes="live" Content="⏹️ stop &amp; analyze" Command="{Binding StopCommand}" />
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource LiveBrush}">
                <Run Text="● recording" />
                <Run Text="{Binding ElapsedText}" />
              </TextBlock>
              <ComboBox ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding LiveWindow}" MinWidth="130"
                        VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsAnalyzing}">
              <ProgressBar IsIndeterminate="True" Width="140" VerticalAlignment="Center" />
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="analyzing… 💗" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsError}">
              <TextBlock Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Text="{Binding ErrorDetail}" />
              <Button Classes="danger" Content="try again" Command="{Binding RetryCommand}" />
            </StackPanel>
            <TextBlock Classes="sub" Foreground="{DynamicResource DangerBrush}" Text="{Binding EngineWarning}"
                       IsVisible="{Binding EngineWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>

        <TextBlock Foreground="{DynamicResource DangerBrush}" Text="{Binding LoadError}"
                   IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- ========== take switcher ========== -->
        <WrapPanel IsVisible="{Binding ShowSwitcher}">
          <TextBlock Classes="cap" VerticalAlignment="Center" Margin="0,0,8,6" Text="viewing:" />
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecordingItemViewModel">
                <!-- TextBlock content: a plain string would turn "_" into an access key -->
                <Button Classes="pick" Classes.active="{Binding IsActive}"
                        Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).SelectCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding PickerText}" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>

        <!-- ========== the take in focus (hidden while a live take is shown) ========== -->
        <Panel IsVisible="{Binding !Record.IsLive}">
          <Panel IsVisible="{Binding HasActive}">
            <v:TakeView DataContext="{Binding Active}" />
          </Panel>
        </Panel>

        <!-- ========== live: while recording, and frozen while the take is analyzed ========== -->
        <StackPanel Spacing="28" IsVisible="{Binding Record.IsLive}">
          <v:LiveTimelinesView DataContext="{Binding Record.LiveTimelines}" />
          <Panel IsVisible="{Binding Record.LiveTake, Converter={x:Static ObjectConverters.IsNotNull}}">
            <v:TakeView DataContext="{Binding Record.LiveTake}" />
          </Panel>
        </StackPanel>

        <!-- ========== 📖 all recordings ========== -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="📖 All recordings" />
          <Border Classes="card" IsVisible="{Binding NoRecordings}">
            <TextBlock Classes="cap" TextAlignment="Center"
                       Text="no recordings yet 💗&#10;record your first take above!" />
          </Border>
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemWidth="372" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecordingItemViewModel">
                <v:RecordingCardView Margin="0,0,12,12" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ========== 💡 cheat sheet ========== -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="💡 What do these mean?" />
          <v:CheatSheetView />
        </StackPanel>

        <TextBlock Classes="cap" HorizontalAlignment="Center" TextAlignment="Center"
                   Text="made with 💗 · numbers are a compass, not a judge · your ears matter most" />
        <TextBlock Classes="cap" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                   Foreground="{DynamicResource InkFaintBrush}" Text="{Binding DataFolder, StringFormat='your takes live in {0}'}" />
      </StackPanel>
    </ScrollViewer>

    <!-- ========== metric reference modal ========== -->
    <Panel IsVisible="{Binding IsModalOpen}">
      <v:MetricModalView DataContext="{Binding Modal}" />
    </Panel>
  </Grid>
</UserControl>
