<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared Avalonia UI (views, view models, custom-drawn charts). Platform
       heads (Reyfen.Timbratune.Desktop today; Android/iOS later) reference this. -->
  <PropertyGroup>
    <RootNamespace>Reyfen.Timbratune</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Feature switch (see Features.cs): real reference voices in the metric comparison. -->
    <TimbratuneReferenceVoices Condition="'$(TimbratuneReferenceVoices)' == ''">false</TimbratuneReferenceVoices>
    <DefineConstants Condition="'$(TimbratuneReferenceVoices)' == 'true'">$(DefineConstants);REFERENCE_VOICES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reyfen.Timbratune.Core\Reyfen.Timbratune.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>
  <ItemGroup Condition="'$(TimbratuneReferenceVoices)' == 'true'">
    <!-- Reference voices (VCTK Corpus, CC BY 4.0 — see Assets/reference/ATTRIBUTION.md).
         Copied next to the app so the audio player can open them as files. -->
    <Content Include="Assets\reference\**" Link="reference\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
