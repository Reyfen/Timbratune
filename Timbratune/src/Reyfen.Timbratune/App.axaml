<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reyfen.Timbratune.App"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the OS light/dark setting, like the React app's "auto" mode. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Reyfen.Timbratune/Themes/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Reyfen.Timbratune/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
