<?xml version="1.0" encoding="utf-8"?>
<!-- Profiling builds only (-p:TimbratuneProfiling=true): the normal manifest plus <profileable>,
     so system tracing and profilers can look into this release build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-feature android:name="android.hardware.microphone" android:required="true" />
  <application android:label="Timbratune" android:icon="@drawable/icon" android:allowBackup="false">
    <profileable android:shell="true" />
  </application>
</manifest>
