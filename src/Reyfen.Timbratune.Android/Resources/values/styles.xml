<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Dark window background while Avalonia starts, so the app doesn't flash white. -->
  <color name="splash_background">#1C1726</color>
  <style name="TimbratuneTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@color/splash_background</item>
  </style>
</resources>
