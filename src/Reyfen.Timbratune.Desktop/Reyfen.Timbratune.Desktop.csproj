<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop head (Windows today; macOS/Linux use the same code). Analysis is
       pure C# (Reyfen.Timbratune.Acoustics), so nothing external is bundled. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Reyfen.Timbratune.Desktop</RootNamespace>
    <ApplicationIcon>..\Reyfen.Timbratune\Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reyfen.Timbratune\Reyfen.Timbratune.csproj" />
    <ProjectReference Include="..\Reyfen.Timbratune.Audio.SoundFlow\Reyfen.Timbratune.Audio.SoundFlow.csproj" />
  </ItemGroup>
  <!-- Single-file publishes are named by version and platform: Timbratune-v0.1.0-win-x64.exe,
       Timbratune-v0.1.0-linux-x64 (the assembly keeps its Reyfen.Timbratune.Desktop name). -->
  <Target Name="NameSingleFileForPlatform" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <_TimbratuneExe>$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)</_TimbratuneExe>
      <_TimbratuneNamed>$(PublishDir)Timbratune-v$(Version)-$(RuntimeIdentifier)$(_NativeExecutableExtension)</_TimbratuneNamed>
    </PropertyGroup>
    <!-- Move won't replace an existing file: drop the previous build first. -->
    <Delete Files="$(_TimbratuneNamed)" Condition="Exists('$(_TimbratuneExe)')" />
    <Move SourceFiles="$(_TimbratuneExe)" DestinationFiles="$(_TimbratuneNamed)" Condition="Exists('$(_TimbratuneExe)')" />
  </Target>
</Project>
