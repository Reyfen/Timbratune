<Project Sdk="Microsoft.NET.Sdk">
  <!-- Import decoding through an ffmpeg program (found on the PATH, or downloaded for the user on
       Linux): practically every format. Runs it as a separate process, so nothing of FFmpeg is
       linked or shipped (its LGPL never touches Timbratune's own license). Desktop heads only. -->
  <PropertyGroup>
    <RootNamespace>Reyfen.Timbratune.Audio.Ffmpeg</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reyfen.Timbratune.Core\Reyfen.Timbratune.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Reyfen.Timbratune.Core.Tests" />
  </ItemGroup>
</Project>
