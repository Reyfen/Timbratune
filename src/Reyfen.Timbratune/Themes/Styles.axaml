<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Visual language of dashboard-react/src/index.css: soft cards (22 px
       radius), pastel accents, lower-case friendly copy. -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- headings & captions -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkHeadingBrush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkHeadingBrush}" />
  </Style>
  <Style Selector="TextBlock.section-sub">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.cap">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkHeadingBrush}" />
  </Style>
  <!-- numbers that change in place (timer, percent): equal-width digits so they don't wobble -->
  <Style Selector="TextBlock.counter">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <!-- the current value beside a live graph's title -->
  <Style Selector="TextBlock.live-value">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkHeadingBrush}" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- A fixed box: the value changes ~10×/s while recording, and a size change would re-lay out its card. -->
    <Setter Property="Width" Value="140" />
    <Setter Property="Height" Value="28" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBlock.unit">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="4,0,0,5" />
  </Style>
  <Style Selector="TextBlock.sub">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="LineHeight" Value="20" />
  </Style>

  <!-- cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
    <!-- On phones App.Initialize swaps this for a crisp, unblurred edge (see MobileLook). -->
    <Setter Property="BoxShadow" Value="0 8 24 0 #22BA8EC4" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="Border.tip">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Background">
      <SolidColorBrush Color="{DynamicResource ZoneFemColor}" Opacity="0.2" />
    </Setter>
  </Style>

  <!-- clickable cards (stat cards, formant gauges): a flat Button so they stay keyboard-reachable -->
  <Style Selector="Button.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
  </Style>
  <Style Selector="Button.card:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
  </Style>
  <Style Selector="Button.card:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.card.inner">
    <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Button.card.inner:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
  </Style>
  <Style Selector="Button.card.inner:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
  </Style>

  <!-- buttons -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="22,10" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.live">
    <Setter Property="Background" Value="{DynamicResource LiveBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="22,10" />
  </Style>
  <Style Selector="Button.live:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkStrongBrush}" />
  </Style>
  <!-- square, framed icon buttons: the take cards' rename / delete / save -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkStrongBrush}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- a pill with a frame, the same height as the record button: import -->
  <Style Selector="Button.outline">
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkStrongBrush}" />
  </Style>
  <!-- the placeholder in italics: "untitled take" is what an unnamed take is called -->
  <Style Selector="TextBox.label-input /template/ TextBlock#PART_Watermark">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <!-- keep the app's input colour while typing (Fluent turns it black / white on focus) -->
  <Style Selector="TextBox.label-input:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
  </Style>
  <Style Selector="TextBox.label-input:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox.label-input:focus">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBox.rename">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,4" />
  </Style>
  <Style Selector="Button.round">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- take switcher pills -->
  <Style Selector="Button.pick">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.pick.active">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBox.label-input">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="MinWidth" Value="300" />
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <!-- footer credits: small faint text with inline links -->
  <Style Selector="TextBlock.footnote">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
  </Style>
  <Style Selector="HyperlinkButton.footlink">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- pill dropdown, matching the pill buttons and the label input -->
  <Style Selector="ComboBox.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="18,10,10,10" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ComboBox.pill:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBox.pill:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBox.pill:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ComboBox.pill /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <Style Selector="ComboBox.pill:pointerover /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBox.pill /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ComboBox.pill ComboBoxItem">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ComboBox.pill ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ComboBox.pill ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <!-- the recording cards' save menu, matching the pill dropdown's popup -->
  <Style Selector="MenuFlyoutPresenter.save-menu">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuFlyoutPresenter.save-menu MenuItem">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="MenuFlyoutPresenter.save-menu MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter.save-menu MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <!-- not available yet: faint, so it reads as "coming", not as broken -->
  <Style Selector="MenuFlyoutPresenter.save-menu MenuItem:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="MenuFlyoutPresenter.save-menu MenuItem:disabled /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
  </Style>

  <!-- recording cards: highlight the one in focus -->
  <Style Selector="Border.rec">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.rec.active">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
    <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
  </Style>
</Styles>
