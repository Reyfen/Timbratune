<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="using:Reyfen.Timbratune.Shell"
        x:Class="Reyfen.Timbratune.Shell.MainWindow"
        x:DataType="sh:ShellViewModel"
        Title="Timbratune — Gender Voice Analysis Tool"
        Icon="avares://Reyfen.Timbratune/Assets/icon.ico"
        Width="1200" Height="900" MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">
  <sh:ShellView />
</Window>
