<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Reyfen.Timbratune.ViewModels"
             xmlns:c="using:Reyfen.Timbratune.Controls"
             x:Class="Reyfen.Timbratune.Views.RecordingCardView"
             x:DataType="vm:RecordingItemViewModel">
  <!-- RecordingCard.tsx + WaveformPlayer.tsx. Clicking the card focuses the take above. -->
  <Border Classes="rec" Classes.active="{Binding IsActive}" ToolTip.Tip="click to view this take above"
          PointerReleased="OnCardClicked">
    <StackPanel Spacing="10">
      <!-- #id and label (plain text, not a button) · rename · date · delete -->
      <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !IsRenaming}">
        <TextBlock VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                   Text="{Binding Id, StringFormat='#{0}'}" />
        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="icon" Content="✏️" ToolTip.Tip="rename this take" Command="{Binding StartRenameCommand}" />
          <TextBlock Classes="cap" VerticalAlignment="Center" Text="{Binding DateLine}" />
          <Button Classes="icon" Content="🗑️" ToolTip.Tip="delete this take"
                  IsEnabled="{Binding !IsConfirmingDelete}" Command="{Binding AskDeleteCommand}" />
        </StackPanel>
      </Grid>
      <!-- renaming: Enter saves, Escape cancels -->
      <Grid x:Name="RenameRow" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsRenaming}">
        <TextBox x:Name="RenameBox" Classes="label-input rename" Text="{Binding RenameText}" MaxLength="80"
                 Watermark="name this take">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmRenameCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Classes="icon" Margin="8,0,0,0" Content="✓" ToolTip.Tip="save the name"
                Command="{Binding ConfirmRenameCommand}" />
        <Button Grid.Column="2" Classes="icon" Margin="8,0,0,0" Content="✕" ToolTip.Tip="cancel"
                Command="{Binding CancelRenameCommand}" />
      </Grid>

      <Border Classes="inset" IsVisible="{Binding IsConfirmingDelete}" Background="{DynamicResource DangerBgBrush}">
        <StackPanel Spacing="8">
          <TextBlock Classes="sub" Foreground="{DynamicResource DangerBrush}" Text="{Binding ConfirmText}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="danger" FontWeight="Bold" Content="yes, delete" Command="{Binding ConfirmDeleteCommand}" />
            <Button Classes="ghost" Content="cancel" Command="{Binding CancelDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <WrapPanel>
        <Border Classes="chip"><StackPanel><TextBlock FontWeight="Bold" Text="{Binding PitchChip}" /><TextBlock Classes="cap" FontSize="10.5" Text="pitch Hz" /></StackPanel></Border>
        <Border Classes="chip"><StackPanel><TextBlock FontWeight="Bold" Text="{Binding RangeChip}" /><TextBlock Classes="cap" FontSize="10.5" Text="range Hz" /></StackPanel></Border>
        <Border Classes="chip"><StackPanel><TextBlock FontWeight="Bold" Text="{Binding F2Chip}" /><TextBlock Classes="cap" FontSize="10.5" Text="F2 Hz" /></StackPanel></Border>
        <Border Classes="chip"><StackPanel><TextBlock FontWeight="Bold" Text="{Binding LoudChip}" /><TextBlock Classes="cap" FontSize="10.5" Text="loud dB" /></StackPanel></Border>
        <Border Classes="chip"><StackPanel><TextBlock FontWeight="Bold" Text="{Binding VariabilityChip}" /><TextBlock Classes="cap" FontSize="10.5" Text="variab Hz" /></StackPanel></Border>
        <Border Classes="chip"><StackPanel><TextBlock FontWeight="Bold" Text="{Binding HnrChip}" /><TextBlock Classes="cap" FontSize="10.5" Text="HNR dB" /></StackPanel></Border>
      </WrapPanel>

      <TextBlock Classes="sub" Text="{Binding Note}" IsVisible="{Binding HasNote}" />

      <Grid ColumnDefinitions="Auto,*,Auto,Auto" IsVisible="{Binding HasAudio}">
        <Button Classes="round" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}" ToolTip.Tip="play / pause" />
        <c:WaveformView Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Peaks="{Binding Peaks}"
                        Progress="{Binding Progress}" SeekCommand="{Binding SeekCommand}" />
        <TextBlock Grid.Column="2" Classes="cap" VerticalAlignment="Center" FontSize="11" Text="{Binding TimeText}" />
        <Button Grid.Column="3" Classes="icon" Content="💾" ToolTip.Tip="{Binding SaveTip}" IsEnabled="{Binding !IsExporting}">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="save-menu">
              <MenuItem Header="🎵 save audio (.wav)" Command="{Binding SaveCopyCommand}" />
              <MenuItem Header="📦 export data (.tmbr)" Command="{Binding ExportDataCommand}"
                        ToolTip.Tip="the audio plus every graph's numbers, in one file" />
              <MenuItem Header="📄 export PDF · coming soon" IsEnabled="False" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
      <TextBlock Classes="cap" Text="{Binding ExportStatus}" IsVisible="{Binding HasExportStatus}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
