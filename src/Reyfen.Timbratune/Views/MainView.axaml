<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Reyfen.Timbratune.ViewModels"
             xmlns:c="using:Reyfen.Timbratune.Controls"
             xmlns:e="using:Reyfen.Timbratune"
             xmlns:v="using:Reyfen.Timbratune.Views"
             x:Class="Reyfen.Timbratune.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource PageBackgroundBrush}">
  <!-- Port of dashboard-react/src/App.tsx: one scrolling page, top to bottom. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseModalCommand}" />
  </UserControl.KeyBindings>

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="1140" Margin="24,20,24,40" Spacing="28">

        <!-- ========== hero ========== -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="h1" Text="Timbratune" />
            <TextBlock Classes="cap" FontSize="14" Text="finding the sound that feels like you 💗✨" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Top" FontSize="18"
                  Content="🌓" ToolTip.Tip="switch light / dark" Command="{Binding ToggleThemeCommand}" />
        </Grid>

        <!-- ========== record panel (RecordButton.tsx) ========== -->
        <Border Classes="card" DataContext="{Binding Record}" x:DataType="vm:RecordViewModel">
          <StackPanel Spacing="8">
            <WrapPanel IsVisible="{Binding IsIdle}">
              <TextBox Classes="label-input" Margin="0,0,10,6" Text="{Binding Label}"
                       Watermark="untitled take" />
              <Button Classes="primary" Margin="0,0,10,6" Content="🎙️ record" Command="{Binding StartCommand}" />
              <Button Classes="outline" Margin="0,0,10,6" Content="📥 import"
                      ToolTip.Tip="add takes from audio files (.wav, .mp3, .flac) or Timbratune files (.tmbr)"
                      Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).ImportCommand}"
                      IsEnabled="{Binding !$parent[v:MainView].((vm:MainViewModel)DataContext).IsImporting}" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6" VerticalAlignment="Center">
                <TextBlock Classes="cap" VerticalAlignment="Center" Text="live graphs show:" />
                <ComboBox Classes="pill" ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding LiveWindow}" MinWidth="150" />
              </StackPanel>
            </WrapPanel>
            <WrapPanel IsVisible="{Binding IsRecording}">
              <Button Classes="live" Margin="0,0,12,6" Content="⏹️ stop &amp; analyze" Command="{Binding StopCommand}" />
              <!-- the time has a fixed width (and equal-width digits) so the controls after it don't shift as it counts -->
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,12,6">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource LiveBrush}" Text="● recording" />
                <TextBlock Classes="counter" MinWidth="40" FontWeight="SemiBold" Foreground="{DynamicResource LiveBrush}" Text="{Binding ElapsedText}" />
              </StackPanel>
              <ComboBox Classes="pill" ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding LiveWindow}" MinWidth="150" Margin="0,0,0,6" />
            </WrapPanel>
            <!-- wraps on a narrow (phone) screen instead of running off its edge -->
            <WrapPanel IsVisible="{Binding IsAnalyzing}">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding AnalysisProgress}" Width="140" VerticalAlignment="Center"
                           Margin="0,0,12,4" />
              <!-- the percentage has a fixed width (and equal-width digits) so the estimate after it doesn't shift -->
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,5,4">
                <TextBlock FontWeight="SemiBold" Text="analyzing…" />
                <TextBlock Classes="counter" MinWidth="38" TextAlignment="Right" FontWeight="SemiBold" Text="{Binding AnalyzingPercent}" />
              </StackPanel>
              <TextBlock Classes="counter" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4" Text="{Binding AnalyzingEstimate}" />
            </WrapPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsError}">
              <TextBlock Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Text="{Binding ErrorDetail}" />
              <Button Classes="danger" Content="try again" Command="{Binding RetryCommand}" />
            </StackPanel>
            <TextBlock Classes="sub" Foreground="{DynamicResource DangerBrush}" Text="{Binding EngineWarning}"
                       IsVisible="{Binding EngineWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="cap" TextWrapping="Wrap"
                       Text="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).ImportStatus}"
                       IsVisible="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).HasImportStatus}" />
          </StackPanel>
        </Border>

        <TextBlock Foreground="{DynamicResource DangerBrush}" Text="{Binding LoadError}"
                   IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- ========== take switcher ========== -->
        <WrapPanel IsVisible="{Binding ShowSwitcher}">
          <TextBlock Classes="cap" VerticalAlignment="Center" Margin="0,0,8,6" Text="viewing:" />
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecordingItemViewModel">
                <!-- TextBlock content: a plain string would turn "_" into an access key -->
                <Button Classes="pick" Classes.active="{Binding IsActive}"
                        Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).SelectCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding PickerText}" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>

        <!-- ========== the take in focus (hidden while a live take is shown) ========== -->
        <Panel IsVisible="{Binding !Record.IsLive}">
          <Panel IsVisible="{Binding HasActive}">
            <v:TakeView DataContext="{Binding Active}" />
          </Panel>
        </Panel>

        <!-- ========== live: while recording, and frozen while the take is analyzed ========== -->
        <StackPanel Spacing="28" IsVisible="{Binding Record.IsLive}">
          <v:LiveTimelinesView DataContext="{Binding Record.LiveTimelines}" />
          <Panel IsVisible="{Binding Record.LiveTake, Converter={x:Static ObjectConverters.IsNotNull}}">
            <v:TakeView DataContext="{Binding Record.LiveTake}" />
          </Panel>
        </StackPanel>

        <!-- ========== 📖 all recordings ========== -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="📖 All recordings" />
          <Border Classes="card" IsVisible="{Binding NoRecordings}">
            <TextBlock Classes="cap" TextAlignment="Center"
                       Text="no recordings yet 💗&#10;record your first take above, or import one!" />
          </Border>
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><c:CardGrid MinItemWidth="340" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecordingItemViewModel">
                <v:RecordingCardView />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ========== 💡 cheat sheet ========== -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="💡 What do these mean?" />
          <v:CheatSheetView />
        </StackPanel>

        <TextBlock Classes="cap" HorizontalAlignment="Center" TextAlignment="Center"
                   Text="made with 💗 · numbers are a compass, not a judge · your ears matter most" />
        <!-- the takes folder: a link that opens it, or (Android) where to find it -->
        <WrapPanel HorizontalAlignment="Center">
          <TextBlock Classes="footnote" Text="your takes live in " />
          <HyperlinkButton Classes="footlink" Content="{Binding DataFolder}" Command="{Binding OpenDataFolderCommand}"
                           IsVisible="{Binding CanOpenDataFolder}" ToolTip.Tip="open the folder · drop audio or .tmbr files in it to import them" />
          <TextBlock Classes="footnote" Text="{Binding DataFolderHint}" TextWrapping="Wrap"
                     IsVisible="{Binding !CanOpenDataFolder}" />
        </WrapPanel>
        <!-- credits: name, version, developer, and where it comes from (links open the browser) -->
        <WrapPanel HorizontalAlignment="Center">
          <TextBlock Classes="footnote" Text="{x:Static e:Features.CreditsText}" />
          <TextBlock Classes="footnote" Text=" · a fork of " />
          <HyperlinkButton Classes="footlink" Content="Euphonia" NavigateUri="{x:Static e:Features.EuphoniaUri}" />
          <TextBlock Classes="footnote" Text=" · algorithms inspired by " />
          <HyperlinkButton Classes="footlink" Content="Praat" NavigateUri="{x:Static e:Features.PraatUri}" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ========== metric reference modal ========== -->
    <Panel IsVisible="{Binding IsModalOpen}">
      <v:MetricModalView DataContext="{Binding Modal}" />
    </Panel>
  </Grid>
</UserControl>
