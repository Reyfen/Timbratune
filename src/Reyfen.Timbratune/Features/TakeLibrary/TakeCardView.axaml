<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tl="using:Reyfen.Timbratune.Features.TakeLibrary"
             xmlns:c="using:Reyfen.Timbratune.Controls"
             x:Class="Reyfen.Timbratune.Features.TakeLibrary.TakeCardView"
             x:DataType="tl:TakeCardViewModel">
  <!-- RecordingCard.tsx + WaveformPlayer.tsx. Clicking the card focuses the take above. -->
  <Border Classes="rec" Classes.active="{Binding IsActive}" ToolTip.Tip="click to view this take above"
          PointerReleased="OnCardClicked">
    <StackPanel Spacing="10">
      <!-- #id · label (click it to rename) · date · delete
           (the label, delete and 💾 open the take's dialog over the page: TakeDialogView). The label
           is a button, so clicking it renames without selecting the take (OnCardClicked skips buttons). -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                   Text="{Binding Id, StringFormat='#{0}'}" />
        <Button Grid.Column="1" Classes="label-link" Margin="8,0" ToolTip.Tip="click to rename this take"
                Command="{Binding StartRenameCommand}">
          <!-- TextBlock content: a plain string would turn "_" into an access key -->
          <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="cap" VerticalAlignment="Center" Text="{Binding DateLine}" />
          <Button Classes="icon" Content="🗑️" ToolTip.Tip="delete this take" Command="{Binding AskDeleteCommand}" />
        </StackPanel>
      </Grid>

      <ItemsControl ItemsSource="{Binding Chips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="tl:TakeChip">
            <Border Classes="chip"><StackPanel><TextBlock FontWeight="Bold" Text="{Binding Value}" /><TextBlock Classes="cap" FontSize="10.5" Text="{Binding Label}" /></StackPanel></Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="sub" Text="{Binding Note}" IsVisible="{Binding HasNote}" />

      <Grid ColumnDefinitions="Auto,*,Auto,Auto" IsVisible="{Binding HasAudio}">
        <Button Classes="round" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}" ToolTip.Tip="play / pause" />
        <c:WaveformView Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Peaks="{Binding Peaks}"
                        Progress="{Binding Progress}" SeekCommand="{Binding SeekCommand}" />
        <TextBlock Grid.Column="2" Classes="cap" VerticalAlignment="Center" FontSize="11" Text="{Binding TimeText}" />
        <!-- two buttons, one shown: 💾 save where there's no share sheet (desktop), share where
             there is (a phone; the share sign, three linked dots, is drawn here) -->
        <Panel Grid.Column="3">
          <Button Classes="icon" Content="💾" ToolTip.Tip="{Binding SaveTip}" IsEnabled="{Binding !IsExporting}"
                  IsVisible="{Binding CanSave}" Command="{Binding OpenSaveMenuCommand}" />
          <Button Classes="icon" ToolTip.Tip="{Binding SaveTip}" IsEnabled="{Binding !IsExporting}"
                  IsVisible="{Binding CanShare}" Command="{Binding OpenSaveMenuCommand}">
            <Viewbox Width="17" Height="17">
              <Canvas Width="24" Height="24">
                <Line StartPoint="18.5,4.5" EndPoint="5.5,12" StrokeThickness="2" Stroke="{DynamicResource AccentBrush}" />
                <Line StartPoint="5.5,12" EndPoint="18.5,19.5" StrokeThickness="2" Stroke="{DynamicResource AccentBrush}" />
                <Ellipse Canvas.Left="15" Canvas.Top="1" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" />
                <Ellipse Canvas.Left="2" Canvas.Top="8.5" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" />
                <Ellipse Canvas.Left="15" Canvas.Top="16" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" />
              </Canvas>
            </Viewbox>
          </Button>
        </Panel>
      </Grid>
      <TextBlock Classes="cap" Text="{Binding ExportStatus}" IsVisible="{Binding HasExportStatus}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
