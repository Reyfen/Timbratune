<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="using:Reyfen.Timbratune.Features.Record"
             x:Class="Reyfen.Timbratune.Features.Record.RecordPanelView"
             x:DataType="rc:RecordViewModel">
  <!-- The record panel (RecordButton.tsx): label, record / stop, the analysis' progress, errors.
       The slots (IdleActions, WindowPicker, Footer) are filled by the Shell. -->
  <Border Classes="card">
    <StackPanel Spacing="8">
      <WrapPanel IsVisible="{Binding IsIdle}">
        <TextBox Classes="label-input" Margin="0,0,10,6" Text="{Binding Label}"
                 PlaceholderText="untitled take" />
        <Button Classes="primary" Margin="0,0,10,6" Content="🎙️ record" Command="{Binding StartCommand}" />
        <ContentControl Content="{Binding IdleActions}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6" VerticalAlignment="Center">
          <TextBlock Classes="cap" VerticalAlignment="Center" Text="live graphs show:" />
          <ContentControl Content="{Binding WindowPicker}" />
        </StackPanel>
      </WrapPanel>
      <WrapPanel IsVisible="{Binding IsRecording}">
        <Button Classes="live" Margin="0,0,12,6" Content="⏹️ stop &amp; analyze" Command="{Binding StopCommand}" />
        <!-- the time has a fixed width (and equal-width digits) so the controls after it don't shift as it counts -->
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,12,6">
          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource LiveBrush}" Text="● recording" />
          <TextBlock Classes="counter" MinWidth="40" FontWeight="SemiBold" Foreground="{DynamicResource LiveBrush}" Text="{Binding ElapsedText}" />
        </StackPanel>
        <ContentControl Content="{Binding WindowPicker}" Margin="0,0,0,6" />
      </WrapPanel>
      <!-- wraps on a narrow (phone) screen instead of running off its edge -->
      <WrapPanel IsVisible="{Binding IsAnalyzing}">
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding AnalysisProgress}" Width="140" VerticalAlignment="Center"
                     Margin="0,0,12,4" />
        <!-- the percentage has a fixed width (and equal-width digits) so the estimate after it doesn't shift -->
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,5,4">
          <TextBlock FontWeight="SemiBold" Text="analyzing…" />
          <TextBlock Classes="counter" MinWidth="38" TextAlignment="Right" FontWeight="SemiBold" Text="{Binding AnalyzingPercent}" />
        </StackPanel>
        <TextBlock Classes="counter" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4" Text="{Binding AnalyzingEstimate}" />
      </WrapPanel>
      <StackPanel Spacing="6" IsVisible="{Binding IsError}">
        <TextBlock Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Text="{Binding ErrorDetail}" />
        <Button Classes="danger" Content="try again" Command="{Binding RetryCommand}" />
      </StackPanel>
      <TextBlock Classes="sub" Foreground="{DynamicResource DangerBrush}" Text="{Binding EngineWarning}"
                 IsVisible="{Binding EngineWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ContentControl Content="{Binding Footer}" />
    </StackPanel>
  </Border>
</UserControl>
